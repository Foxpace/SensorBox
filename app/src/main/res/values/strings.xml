    <string name="intro_welcome_title">Welcome to SensorBox</string>
    <string name="intro_welcome_body">Record phone sensors and GPS to CSV files, with companion support for Wear OS.</string>
    <string name="intro_incognito_title">Nothing is going out</string>
    <string name="intro_incognito_body">Measurements stay locally on your devices. SensorBox has no analytics, cloud upload, or account requirement.</string>
    <string name="intro_policy_title">Privacy and terms</string>
    <string name="intro_policy_body">Review the policies before continuing. SensorBox only records when you explicitly start recording.</string>
    <string name="intro_policy_button">Privacy policy</string>
    <string name="intro_terms_button">Terms of use</string>
    <string name="intro_lifecycle_title">Android may pause recordings</string>
    <string name="intro_lifecycle_body">Power-saving routines can stop sensors after the screen turns off or terminate long-running work, especially on manufacturer-customized Android versions.</string>
    <string name="intro_battery_title">Allow reliable background work</string>
    <string name="intro_battery_body">You can ask Android to exempt SensorBox from battery optimization. This is optional and can be changed later in system settings.</string>
    <string name="intro_battery_action">Review battery settings</string>
    <string name="intro_archive_title">Choose a recording archive</string>
    <string name="intro_archive_body">Android’s folder picker gives SensorBox access only to the directory you choose as the recording archive. An archive is required before finishing setup.</string>
